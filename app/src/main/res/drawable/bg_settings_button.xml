<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF343459" />
            <stroke android:width="2dp" android:color="#FFFFCC00" />
            <corners android:radius="3dp" />
            <padding android:left="14dp" android:top="7dp" android:right="14dp" android:bottom="7dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FF20202D" />
            <stroke android:width="1dp" android:color="#FF44444F" />
            <corners android:radius="3dp" />
            <padding android:left="14dp" android:top="7dp" android:right="14dp" android:bottom="7dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF252542" />
            <stroke android:width="1dp" android:color="#FF66667A" />
            <corners android:radius="3dp" />
            <padding android:left="14dp" android:top="7dp" android:right="14dp" android:bottom="7dp" />
        </shape>
    </item>
</selector>
