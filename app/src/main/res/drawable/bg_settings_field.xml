<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF20203A" />
            <stroke android:width="2dp" android:color="#FFFFCC00" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF18182B" />
            <stroke android:width="1dp" android:color="#FF55556E" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
