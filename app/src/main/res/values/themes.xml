<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main app theme — AppCompat base required for AppCompatActivity -->
    <style name="Theme.SignalDVR" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Fullscreen player — black background, no title, no action bar -->
    <style name="Theme.SignalDVR.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

</resources>
