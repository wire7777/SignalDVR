<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/media3_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:keepScreenOn="true"
        app:use_controller="false"
        app:surface_type="texture_view"
        app:keep_content_on_player_reset="true" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/loading_bar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>

    <com.signaldvr.app.ui.player.GuideOverlayView
        android:id="@+id/guide_overlay"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <com.signaldvr.app.ui.player.QuickGuideOverlayView
        android:id="@+id/quick_guide_overlay"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:elevation="24dp"
        android:visibility="gone" />

    <com.signaldvr.app.ui.player.FullInfoOverlayView
        android:id="@+id/full_info_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="30dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dvr_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="170dp"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="#FFFFCC00"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"
            android:text="● LIVE" />

        <com.signaldvr.app.ui.player.TimelineView
            android:id="@+id/timelineView"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/btn_rew60"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:text="⏮ 60s"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:focusable="true"
                android:background="@drawable/bg_channel_normal" />

            <TextView
                android:id="@+id/btn_rew30"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:text="⏪ 30s"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:focusable="true"
                android:background="@drawable/bg_channel_normal" />

            <TextView
                android:id="@+id/btn_rew10"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:text="◀ 10s"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:focusable="true"
                android:background="@drawable/bg_channel_normal" />

            <TextView
                android:id="@+id/btn_play_pause"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:text="⏸"
                android:textColor="#FFFFCC00"
                android:textSize="24sp"
                android:focusable="true"
                android:background="@drawable/bg_channel_normal" />

            <TextView
                android:id="@+id/btn_ff10"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:text="10s ▶"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:focusable="true"
                android:background="@drawable/bg_channel_normal" />

            <TextView
                android:id="@+id/btn_ff30"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:text="30s ⏩"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:focusable="true"
                android:background="@drawable/bg_channel_normal" />

            <TextView
                android:id="@+id/btn_ff60"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:text="60s ⏭"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:focusable="true"
                android:background="@drawable/bg_channel_normal" />

            <TextView
                android:id="@+id/btn_live"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:text="● LIVE"
                android:textColor="#FF00FF00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:focusable="true"
                android:background="@drawable/bg_channel_normal" />

            <TextView
                android:id="@+id/btn_record"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:text="⏺ REC"
                android:textColor="#FFFF4444"
                android:textSize="13sp"
                android:textStyle="bold"
                android:focusable="true"
                android:background="@drawable/bg_channel_normal" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>