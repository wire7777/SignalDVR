<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/media3_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        android:visibility="visible"
        app:keep_content_on_player_reset="true"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <LinearLayout
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/loading_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:visibility="gone" />

    </LinearLayout>

    <com.signaldvr.app.ui.player.GuideOverlayView
        android:id="@+id/guide_overlay"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <com.signaldvr.app.ui.player.QuickGuideOverlayView
        android:id="@+id/quick_guide_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.signaldvr.app.ui.player.FullInfoOverlayView
        android:id="@+id/full_info_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!--
        Lightweight commercial-DVR transport panel.
        Existing view IDs are preserved so no playback logic changes are needed.
    -->
    <LinearLayout
        android:id="@+id/dvr_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E6101014"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="8dp"
        android:paddingEnd="28dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_position"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text=""
            android:visibility="gone" />

        <com.signaldvr.app.ui.player.TimelineView
            android:id="@+id/timelineView"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Retained for PlayerActivity binding; hidden from the simplified UI. -->
            <TextView
                android:id="@+id/btn_rew60"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:focusable="false"
                android:text="-60"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_rew30"
                android:layout_width="88dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/bg_channel_normal"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:nextFocusRight="@id/btn_rew10"
                android:text="↶ 30"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_rew10"
                android:layout_width="88dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/bg_channel_normal"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:nextFocusLeft="@id/btn_rew30"
                android:nextFocusRight="@id/btn_play_pause"
                android:text="↶ 10"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_play_pause"
                android:layout_width="78dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="7dp"
                android:background="@drawable/bg_channel_normal"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:nextFocusLeft="@id/btn_rew10"
                android:nextFocusRight="@id/btn_ff10"
                android:text="⏸"
                android:textColor="#FFFFCC00"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/btn_ff10"
                android:layout_width="88dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/bg_channel_normal"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:nextFocusLeft="@id/btn_play_pause"
                android:nextFocusRight="@id/btn_ff30"
                android:text="10 ↷"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_ff30"
                android:layout_width="88dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/bg_channel_normal"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:nextFocusLeft="@id/btn_ff10"
                android:nextFocusRight="@id/btn_live"
                android:text="30 ↷"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <!-- Retained for PlayerActivity binding; hidden from the simplified UI. -->
            <TextView
                android:id="@+id/btn_ff60"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:focusable="false"
                android:text="+60"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_live"
                android:layout_width="94dp"
                android:layout_height="42dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_channel_normal"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:nextFocusLeft="@id/btn_ff30"
                android:nextFocusRight="@id/btn_record"
                android:text="● LIVE"
                android:textColor="#FF56E36F"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_record"
                android:layout_width="94dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/bg_channel_normal"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:nextFocusLeft="@id/btn_live"
                android:text="● REC"
                android:textColor="#FFFF5A5F"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>