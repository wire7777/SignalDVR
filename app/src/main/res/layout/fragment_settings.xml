<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    android:focusable="false"
    android:paddingStart="54dp"
    android:paddingTop="26dp"
    android:paddingEnd="54dp"
    android:paddingBottom="26dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/settings_title"
                android:src="@drawable/ic_home_settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/settings_title"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_server_section"
            android:textColor="#FFFFCC00"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_server_address"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/settings_server_help"
            android:textColor="@color/settings_secondary_text"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/settings_server_address"
            android:layout_width="720dp"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_settings_field"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:selectAllOnFocus="false"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF999999"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settings_test_connection"
                android:layout_width="190dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_settings_button"
                android:focusable="true"
                android:text="@string/settings_test_connection"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/settings_save"
                android:layout_width="140dp"
                android:layout_height="50dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_settings_button"
                android:focusable="true"
                android:text="@string/settings_save"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/settings_connection_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="24dp"
            android:textColor="@color/settings_secondary_text"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#FF444444" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/settings_cache_section"
            android:textColor="#FFFFCC00"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_clear_cache"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_settings_button"
            android:focusable="true"
            android:text="@string/settings_clear_cache"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#FF444444" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/settings_about_section"
            android:textColor="#FFFFCC00"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_app_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
