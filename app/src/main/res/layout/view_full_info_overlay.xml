<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F20F141C"
    android:paddingStart="42dp"
    android:paddingTop="22dp"
    android:paddingEnd="42dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:id="@+id/full_info_header"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/full_info_logo"
            android:layout_width="72dp"
            android:layout_height="42dp"
            android:adjustViewBounds="true"
            android:contentDescription="Channel logo"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/full_info_channel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/full_info_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#FFD9DEE5"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/full_info_header_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#2A3544"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/full_info_header"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/full_info_actions"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/full_info_help">

        <TextView
            android:id="@+id/full_info_watch"
            android:layout_width="220dp"
            android:layout_height="46dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/bg_full_info_button_focused"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="WATCH LIVE"
            android:textColor="#FFFFD54F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/full_info_record"
            android:layout_width="220dp"
            android:layout_height="46dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/bg_full_info_button_normal"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="RECORD SHOW"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/full_info_close"
            android:layout_width="170dp"
            android:layout_height="46dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/bg_full_info_button_normal"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="CLOSE"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/full_info_help"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="◀▶ Select   OK Choose   Back Close"
        android:textColor="#FF8E98A5"
        android:textSize="9sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/full_info_action_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginBottom="7dp"
        android:background="#2A3544"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/full_info_actions" />

    <LinearLayout
        android:id="@+id/full_info_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/full_info_header_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/full_info_action_divider">

        <ImageView
            android:id="@+id/full_info_artwork"
            android:layout_width="170dp"
            android:layout_height="255dp"
            android:layout_marginEnd="28dp"
            android:adjustViewBounds="true"
            android:contentDescription="Program artwork"
            android:scaleType="fitCenter" />

        <ScrollView
            android:id="@+id/full_info_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/full_info_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/full_info_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="#FFE2E7ED"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/full_info_badges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="#FFFFC107"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/full_info_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/full_info_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="#FFFFC107"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/full_info_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="7dp"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="#FF384351"
                    android:progressTint="#FFFFC107" />

                <TextView
                    android:id="@+id/full_info_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:includeFontPadding="false"
                    android:maxLines="3"
                    android:textColor="#FFB9C2CD"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/full_info_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="8"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#2A3544" />

                <TextView
                    android:id="@+id/full_info_cast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="#FFD6DCE3"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/full_info_directors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFC7CED6"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/full_info_writers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFC7CED6"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/full_info_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"
                    android:background="#1A2230"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
