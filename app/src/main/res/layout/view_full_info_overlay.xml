<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F20A0C12"
    android:paddingStart="42dp"
    android:paddingTop="28dp"
    android:paddingEnd="42dp"
    android:paddingBottom="26dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/full_info_logo"
                android:layout_width="72dp"
                android:layout_height="42dp"
                android:adjustViewBounds="true"
                android:contentDescription="Channel logo"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/full_info_channel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/full_info_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFDDDDDD"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#406B7280" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="225dp"
                android:layout_marginEnd="24dp"
                android:background="#FF191C24">

                <ImageView
                    android:id="@+id/full_info_artwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="Program artwork"
                    android:scaleType="fitCenter"/>
            </FrameLayout>

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/full_info_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#FFFFFFFF"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/full_info_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#FFE2E2E2"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/full_info_badges"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#FFFFCC00"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/full_info_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="#FFFFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/full_info_remaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFCC00"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/full_info_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressBackgroundTint="#FF4B4F58"
                        android:progressTint="#FFFFCC00" />

                    <TextView
                        android:id="@+id/full_info_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:textColor="#FFBFC3CA"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/full_info_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="17dp"
                        android:lineSpacingExtra="5dp"
                        android:maxLines="8"
                        android:textColor="#FFFFFFFF"
                        android:textSize="18sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="17dp"
                        android:background="#355E6570" />

                    <TextView
                        android:id="@+id/full_info_cast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:maxLines="3"
                        android:textColor="#FFD8D8D8"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/full_info_directors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:maxLines="2"
                        android:textColor="#FFC8C8C8"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/full_info_writers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:maxLines="2"
                        android:textColor="#FFC8C8C8"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/full_info_next"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="8dp"
                        android:background="#241E88E5"
                        android:padding="12dp"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#406B7280" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/full_info_watch"
                android:layout_width="240dp"
                android:layout_height="56dp"
                android:layout_margin="7dp"
                android:background="@drawable/bg_channel_focused"
                android:gravity="center"
                android:text="WATCH LIVE"
                android:textColor="#FFFFFF66"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/full_info_record"
                android:layout_width="240dp"
                android:layout_height="56dp"
                android:layout_margin="7dp"
                android:background="@drawable/bg_channel_normal"
                android:gravity="center"
                android:text="RECORD SHOW"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/full_info_close"
                android:layout_width="190dp"
                android:layout_height="56dp"
                android:layout_margin="7dp"
                android:background="@drawable/bg_channel_normal"
                android:gravity="center"
                android:text="CLOSE"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="◀▶ Select   OK Choose   Back Close"
            android:textColor="#FF9EA3AA"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>