<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EE101010" />

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#FF1688D4" />

    <LinearLayout
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp">

        <ImageView
            android:id="@+id/overlay_channel_logo"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:layout_marginBottom="1dp"
            android:adjustViewBounds="true"
            android:contentDescription="Channel logo"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/overlay_channel_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_channel_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFB8B8B8"
            android:textSize="11sp" />

    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="100dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:background="#35FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="101dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="7dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/overlay_current_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlay_status_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="26dp"
                android:textColor="#FF29A9F3"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlay_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:includeFontPadding="false"
                android:textColor="#FFE0E0E0"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/overlay_current_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFB8B8B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/overlay_time_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFD0D0D0"
                android:textSize="12sp" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/overlay_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#3DFFFFFF"
            android:progressTint="#FF1688D4" />

        <TextView
            android:id="@+id/overlay_next_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FF4DB8F7"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</merge>