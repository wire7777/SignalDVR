<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_channel_normal"
    android:focusable="true"
    android:paddingStart="12dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Thumbnail -->
    <ImageView
        android:id="@+id/rec_thumbnail"
        android:layout_width="150dp"
        android:layout_height="84dp"
        android:layout_marginEnd="16dp"
        android:scaleType="centerCrop"
        android:background="#111122" />

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rec_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/rec_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFAAAAAA"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/rec_channel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFCC00"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/rec_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF0077CC"
                android:textSize="13sp"
                android:layout_marginStart="12dp" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
