<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EE101010"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/quick_guide_info_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/quick_guide_channel_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="17.1"
                        android:textColor="#FFFFCC00"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/quick_guide_channel_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="KGET-HD"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/quick_guide_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFDDDDDD"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/quick_guide_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="No guide data"
                    android:textColor="#FFFFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quick_guide_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFDDDDDD"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/quick_guide_badges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FFFFCC00"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/quick_guide_artwork"
                android:layout_width="90dp"
                android:layout_height="135dp"
                android:layout_marginStart="12dp"
                android:adjustViewBounds="true"
                android:contentDescription="Program artwork"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quick_guide_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/quick_guide_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#FFCCCCCC"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/quick_guide_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#FF555555"
            android:progressTint="#FFFFCC00" />

        <TextView
            android:id="@+id/quick_guide_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFBBBBBB"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/quick_guide_description"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="top"
            android:maxLines="7"
            android:text="No guide information is available for this channel."
            android:textColor="#FFDDDDDD"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/quick_guide_credits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFAAAAAA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/quick_guide_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFAAAAAA"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#FF555555" />

    <LinearLayout
        android:id="@+id/quick_guide_channels_panel"
        android:layout_width="match_parent"
        android:layout_height="196dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHANNELS"
            android:textColor="#FFFFCC00"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/quick_guide_channel_list"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/quick_guide_more_info"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_channel_focused"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="MORE INFO  ▶"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="▲▼ Browse   OK Tune   ▶ More Info   Back Close"
            android:textColor="#FFBBBBBB"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>