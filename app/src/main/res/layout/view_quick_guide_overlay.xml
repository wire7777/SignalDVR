<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EE101010"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!--
        Flexible information area.

        This area gives up height when necessary so the fixed three-row
        channel selector always remains completely inside the screen.
    -->
    <LinearLayout
        android:id="@+id/quick_guide_info_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="0dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/quick_guide_channel_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="17.1"
                        android:textColor="#FFFFCC00"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/quick_guide_channel_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="KGET-HD"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/quick_guide_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFDDDDDD"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/quick_guide_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="No guide data"
                    android:textColor="#FFFFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quick_guide_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFDDDDDD"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/quick_guide_badges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="#FFFFCC00"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/quick_guide_artwork"
                android:layout_width="110dp"
                android:layout_height="165dp"
                android:layout_marginStart="12dp"
                android:adjustViewBounds="true"
                android:contentDescription="Program artwork"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quick_guide_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/quick_guide_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFCCCCCC"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/quick_guide_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#FF2A3544"
            android:progressTint="#FFFFCC00" />

        <TextView
            android:id="@+id/quick_guide_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="#FFBBBBBB"
            android:textSize="13sp" />

        <!--
            This is the only flexible text block. It shrinks before the
            three fixed channel rows are allowed to move off-screen.
        -->
        <TextView
            android:id="@+id/quick_guide_description"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="top"
            android:includeFontPadding="false"
            android:maxLines="7"
            android:minHeight="0dp"
            android:text="No guide information is available for this channel."
            android:textColor="#FFDDDDDD"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/quick_guide_credits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="#FFAAAAAA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/quick_guide_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFAAAAAA"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#2A3544" />

    <!--
        Kotlin creates exactly three rows at 30dp each.

        Previous bug:
            panel height = 52dp
            required height = 3 × 30dp = 90dp

        The panel and list are now both exactly 90dp.
    -->
    <LinearLayout
        android:id="@+id/quick_guide_channels_panel"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/quick_guide_channel_list"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical" />

    </LinearLayout>

</LinearLayout>