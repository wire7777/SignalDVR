<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/library_section_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Library section"
            android:padding="2dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/library_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/library_section_empty"
        android:layout_width="360dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_channel_normal"
        android:gravity="center"
        android:text="Nothing here yet."
        android:textColor="#FF888888"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/library_section_recycler"
        android:layout_width="match_parent"
        android:layout_height="232dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:paddingRight="36dp" />

</LinearLayout>
