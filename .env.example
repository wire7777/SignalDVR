TZ=America/Los_Angeles
SIGNALDVR_PORT=8088
SIGNALDVR_WEB_THREADS=8

# Leave these as relative folders for a self-contained test install,
# or replace them with absolute host paths for production storage.
SIGNALDVR_CONFIG_HOST=./data/config
SIGNALDVR_RECORDINGS_HOST=./data/recordings
SIGNALDVR_TIMESHIFT_HOST=./data/timeshift
SIGNALDVR_THUMBNAILS_HOST=./data/thumbnails
SIGNALDVR_LOGS_HOST=./data/logs
SIGNALDVR_GUIDE_HOST=./data/guide

# Web concurrency: 8 is a safe default for most systems.
# Small devices can use 4; larger installations can use 12-16.

# Optional overrides. These can also be configured in SignalDVR Settings.
SIGNALDVR_GUIDE_URL=
# SIGNALDVR_HDHR_DEVICE=1077144F
